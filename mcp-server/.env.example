# Copy to .env and fill in. NEVER commit .env — it holds a live private key.
# Write tools (register_payee, execute_guarded_payment) are DISABLED unless
# AGENT_PRIVATE_KEY is set here. The key must be a 0x-prefixed hex string for
# a dedicated LOW-BALANCE testnet wallet only. Never use a mainnet key.
AGENT_PRIVATE_KEY=0x
# Optional overrides (defaults already point at the live deployment):
# QDAY_RPC_URL=https://rpc-test.qday.info
