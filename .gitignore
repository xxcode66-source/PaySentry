# Dependencies
node_modules/
lib/
!app/src/lib/
!app/src/lib/**

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/

# deployments/ holds PUBLIC contract addresses — keep it tracked, but
# never the broadcast cache (it can contain key material in cache/).
!contracts/deployments/
contracts/deployments/*.tmp

# Secrets — NEVER commit
.env
.env.local
.env*.local
*.pem

# Next.js
app/.next/
app/out/
app/build/
next-env.d.ts

# Misc
.DS_Store
*.log
.vscode/
.idea/

# paysentry-sdk (built output + deps)
sdk/dist/
sdk/node_modules/

# Android build outputs
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
android/.kotlin/
*.apk
*.aab
*.keystore
*.jks
.gradle/
android/app/debug/
android/app/build/
